{
  "name": "@sylvie/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sylvie TaskList 领域模型：类型、默认值、排序、迁移与设置定义（内部包，直接以 TS 源码形式被应用消费）",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .turbo",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sylvie/eslint-config": "workspace:*",
    "@sylvie/tsconfig": "workspace:*",
    "eslint": "^9.18.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^5.1.1"
  }
}
